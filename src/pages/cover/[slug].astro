---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profile } from "../../data/profile";
import "../../styles/global.css";

export const getStaticPaths = (async () => {
  const letters = await getCollection("organizations");

  return letters.map((letter) => ({
    params: { slug: letter.slug },
    props: { letter },
  }));
}) satisfies GetStaticPaths;

const { letter } = Astro.props;
const { Content } = await letter.render();
const {
  organization,
  recipient,
  address,
  city,
  state,
  zipcode,
  subject,
  greeting,
  closing,
  date,
} = letter.data;

const formattedDate = date.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout title={`${profile.name} — Cover Letter for ${organization}`}>
  <main class="cover-page">
    <div class="cover-toolbar no-print">
      <a href="/">← Resume</a>
      <button type="button" onclick="window.print()">Print / Save PDF</button>
    </div>

    <article class="cover-letter">
      <div class="letter-date">{formattedDate}</div>

      <address class="recipient">
        <span>{organization}</span>
        <span>{address}</span>
        <span>{city}, {state} {zipcode}</span>
      </address>

      <p class="subject"><strong>Re:</strong> {subject}</p>
      <p>{greeting}</p>

      <div class="letter-body">
        <Content />
      </div>

      <footer class="signature">
        <p>{closing}</p>
        <p>{profile.name}</p>
      </footer>
    </article>
  </main>
</BaseLayout>

<style>
  .cover-page {
    min-height: 100vh;
    padding: 2rem 1rem 4rem;
  }

  .cover-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: min(100%, 8.5in);
    margin: 0 auto 1rem;
    font-size: 0.875rem;
  }

  .cover-toolbar a {
    color: #52525b;
    text-decoration: none;
  }

  .cover-toolbar button {
    border: 0;
    border-radius: 0.375rem;
    background: #18181b;
    color: white;
    padding: 0.625rem 1rem;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .cover-letter {
    box-sizing: border-box;
    width: min(100%, 8.5in);
    min-height: 11in;
    margin: 0 auto;
    padding: 0.75in 0.65in;
    background: white;
    box-shadow: 0 10px 35px rgb(0 0 0 / 8%);
    color: #18181b;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 11pt;
    line-height: 1.45;
  }

  .letter-date,
  .recipient,
  .subject,
  .signature p {
    margin: 0;
  }

  .recipient {
    display: flex;
    flex-direction: column;
    margin-top: 0.22in;
    font-style: normal;
  }

  .subject {
    margin-top: 0.25in;
  }

  .subject + p {
    margin: 0.25in 0 0;
  }

  .letter-body :global(p) {
    margin: 0.16in 0 0;
  }

  .letter-body :global(ul) {
    margin: 0.12in 0 0;
    padding-left: 0.25in;
    list-style-type: disc;
    list-style-position: outside;
  }

  .letter-body :global(li) {
    margin-top: 0.045in;
    padding-left: 0.03in;
  }

  .letter-body :global(li::marker) {
    color: #3f3f46;
  }

  .signature {
    margin-top: 0.25in;
  }

  .signature p:last-child {
    margin-top: 0.36in;
    font-weight: 700;
  }

  @media (max-width: 700px) {
    .cover-letter {
      min-height: 0;
      padding: 2rem 1.5rem;
      font-size: 11pt;
    }
  }

  @media print {
    @page {
      size: letter;
      margin: 0;
    }

    .cover-page {
      min-height: 0;
      padding: 0;
    }

    .cover-letter {
      width: 8.5in;
      min-height: 11in;
      padding: 0.65in 0.85in;
      box-shadow: none;
      font-size: 10.5pt;
      line-height: 1.42;
    }
  }
</style>
