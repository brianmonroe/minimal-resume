---
import Icon from "./Icon.astro";

const { id, title, subtitle, icon } = Astro.props;
---

<section
  id={id}
  class="py-6 print:py-2"
>
  <div class="container-narrow">
    <div class="mb-6">
      <h2 class="flex items-center gap-3 text-3xl font-semibold tracking-tight">
        {icon && (
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-zinc-900 text-white print:hidden">
            <Icon name={icon} class="h-5 w-5" />
          </span>
        )}
        {title}
      </h2>
      {subtitle ? <p class="mt-1 text-sm text-zinc-600">{subtitle}</p> : null}
    </div>
    <slot />
  </div>
</section>
