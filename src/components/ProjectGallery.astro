---
import { Image } from "astro:assets";
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import { projects } from "../data/projects";
import derby02 from "../assets/photo_gallery/derby_02.jpg";
import derby03 from "../assets/photo_gallery/derby_03.jpg";
import bertkeSenior from "../assets/photo_gallery/bertke_sp_2019105-16.jpg";
import liaIcebreaker from "../assets/photo_gallery/bmp-lia-2020icebreaker-3.jpg";
import liaWinterDance from "../assets/photo_gallery/lia-winter-dance-2024-22.jpg";
import eversFamily from "../assets/photo_gallery/2022-evers-family-24.jpg";
import tayaSoccer from "../assets/photo_gallery/2025-soccer-taya-beavercreak-287.jpg";
import kidsSoccer from "../assets/photo_gallery/soccer-80.jpg";
import mooseOfficers from "../assets/photo_gallery/moose-officers-2020-2-9.jpg";
import billermanSenior from "../assets/photo_gallery/billerman-senior-2023-17.jpg";
import billermanBoardwalk from "../assets/photo_gallery/2025-senior-billerman-boardwalk-31.jpg";

const icons = {
  ecommerce: `
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-10 h-10">
      <path d="M6 6h15l-1.5 9h-13z" />
      <circle cx="9" cy="21" r="1" />
      <circle cx="18" cy="21" r="1" />
    </svg>
  `,
  html: `
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-10 h-10">
      <polyline points="16 18 22 12 16 6" />
      <polyline points="8 6 2 12 8 18" />
    </svg>
  `,
  photography: `
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-10 h-10">
      <path d="M23 19V7a2 2 0 0 0-2-2h-3l-2-3h-8l-2 3H3a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h18a2 2 0 0 0 2-2z" />
      <circle cx="12" cy="13" r="4" />
    </svg>
  `,
  github: `
    <svg viewBox="0 0 24 24" fill="currentColor" class="w-10 h-10">
      <path d="M12 0C5.37 0 0 5.5 0 12.3c0 5.44 3.44 10.06 8.21 11.69.6.12.82-.27.82-.6 0-.29-.01-1.07-.02-2.1-3.34.75-4.04-1.67-4.04-1.67-.55-1.42-1.34-1.8-1.34-1.8-1.1-.78.08-.77.08-.77 1.22.09 1.86 1.28 1.86 1.28 1.08 1.9 2.83 1.35 3.52 1.03.11-.8.42-1.35.76-1.66-2.67-.31-5.47-1.37-5.47-6.1 0-1.35.46-2.45 1.22-3.31-.12-.31-.53-1.57.12-3.27 0 0 1-.33 3.3 1.27a11.1 11.1 0 0 1 6 0C17.3 3.3 18.3 3.63 18.3 3.63c.65 1.7.24 2.96.12 3.27.76.86 1.22 1.96 1.22 3.31 0 4.75-2.8 5.79-5.48 6.1.43.38.81 1.12.81 2.26 0 1.63-.02 2.94-.02 3.34 0 .33.22.72.82.6C20.56 22.36 24 17.74 24 12.3 24 5.5 18.63 0 12 0z"/>
    </svg>
  `,
};

const galleryImages = [
  { src: derby02, alt: "Placeholder senior photography" },
  { src: derby03, alt: "Placeholder senior photography" },
  { src: bertkeSenior, alt: "Placeholder celebration photography" },
  { src: liaIcebreaker, alt: "Placeholder celebration photography" },
  { src: liaWinterDance, alt: "Placeholder celebration photography" },
  { src: eversFamily, alt: "Placeholder celebration photography" },
  { src: tayaSoccer, alt: "Placeholder celebration photography" },
  { src: kidsSoccer, alt: "Kids soccer photo." },
  { src: mooseOfficers, alt: "Placeholder sports photography" },
  { src: billermanSenior, alt: "Placeholder event photography" },
  { src: billermanBoardwalk, alt: "Placeholder event photography" },
];
---

<Section id="projects" title="Project Gallery" icon="projects">
  <div class="grid md:grid-cols-2 gap-6 print-gap-tight">
    {projects.map((p) => {
      return (
        <article
          class="group flex w-full flex-col overflow-hidden rounded-xl bg-white text-left shadow-sm"
        >
          <div
            class="relative flex h-24 w-full shrink-0 items-center justify-center overflow-hidden bg-zinc-900 bg-cover bg-center text-white sm:h-28"
            style={`background-image: url("${p.image}")`}
          >
            <div class="absolute inset-0 bg-gradient-to-b from-zinc-900/40 via-zinc-900/80 to-zinc-900"></div>
            <div class="relative z-10" set:html={icons[p.icon]} />
          </div>

          <div class="flex flex-1 flex-col p-5">
            <p class="text-xs font-medium uppercase tracking-wide text-zinc-500">
              {p.type}
            </p>

            <h3 class="mt-1 text-base font-semibold tracking-tight md:text-lg">
              {p.title}
            </h3>

            <p class="mt-2 text-sm text-zinc-700 leading-relaxed">
              {p.description}
            </p>

            <div class="mt-auto flex flex-wrap gap-x-4 gap-y-2 pt-4">
              {p.gallery ? (
                <button
                  type="button"
                  data-gallery-trigger
                  aria-haspopup="dialog"
                  class="appearance-none border-0 bg-transparent p-0 text-sm font-medium text-zinc-900 decoration-zinc-400 underline-offset-4 hover:underline focus-visible:underline focus:outline-none focus:ring-2 focus:ring-zinc-400"
                >
                  Launch Photo Gallery <span aria-hidden="true">→</span>
                </button>
              ) : p.link && (
                <a
                  href={p.link}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-900 decoration-zinc-400 underline-offset-4 hover:underline focus-visible:underline"
                >
                  View Website
                  <Icon name="external" class="h-4 w-4" />
                </a>
              )}

              <button
                type="button"
                data-project-details-trigger
                data-project-title={p.title}
                aria-haspopup="dialog"
                class="inline-flex appearance-none items-center gap-1.5 border-0 bg-transparent p-0 text-sm font-medium text-zinc-600 decoration-zinc-400 underline-offset-4 hover:text-zinc-900 hover:underline focus-visible:underline focus:outline-none focus:ring-2 focus:ring-zinc-400"
              >
                View Project Details
                <Icon name="info" class="h-4 w-4" />
              </button>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</Section>

<dialog
  data-project-details-dialog
  aria-labelledby="project-details-title"
  class="m-auto w-[min(92vw,40rem)] max-w-none rounded-2xl bg-white p-0 text-zinc-900 shadow-2xl backdrop:bg-black/70"
>
  <div class="p-6 sm:p-8">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p data-project-details-type class="text-xs font-medium uppercase tracking-widest text-zinc-500"></p>
        <h2 id="project-details-title" data-project-details-title class="mt-1 text-2xl font-semibold tracking-tight"></h2>
      </div>
      <button
        type="button"
        data-project-details-close
        class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-zinc-100 text-2xl leading-none transition hover:bg-zinc-200 focus:outline-none focus:ring-2 focus:ring-zinc-400"
        aria-label="Close project details"
      >
        &times;
      </button>
    </div>

    <ul data-project-details-list class="mt-6 list-disc space-y-3 pl-5 text-sm leading-relaxed text-zinc-700"></ul>
  </div>
</dialog>

<script type="application/json" data-project-details-data set:html={JSON.stringify(
  Object.fromEntries(projects.map((project) => [
    project.title,
    { type: project.type, details: project.details },
  ]))
).replace(/</g, "\\u003c")} />

<dialog
  data-photo-gallery
  aria-labelledby="photo-gallery-title"
  class="m-auto w-[min(94vw,72rem)] max-w-none overflow-visible rounded-2xl bg-zinc-950 p-0 text-white backdrop:bg-black/80"
>
  <div class="relative p-4 sm:p-6">
    <div class="mb-4 flex items-center justify-between gap-4">
      <div>
        <p class="text-xs font-medium uppercase tracking-widest text-zinc-400">Photography</p>
        <h2 id="photo-gallery-title" class="mt-1 text-2xl font-semibold">Photo Gallery</h2>
      </div>
      <button
        type="button"
        data-gallery-close
        class="grid h-10 w-10 place-items-center rounded-full bg-white/10 text-2xl leading-none transition hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white"
        aria-label="Close photo gallery"
      >
        &times;
      </button>
    </div>

    <div
      data-gallery-track
      class="flex snap-x snap-mandatory gap-4 overflow-x-auto overscroll-x-contain scroll-smooth pb-4"
      aria-label="Photography gallery images"
    >
      {galleryImages.map((image) => (
        <figure class="flex h-[65vh] max-h-[44rem] w-full shrink-0 snap-center items-center justify-center overflow-hidden rounded-xl bg-black">
          <Image
            src={image.src}
            alt={image.alt}
            widths={[480, 900, 1400, 2000]}
            sizes="(max-width: 768px) 94vw, 1100px"
            format="webp"
            quality={80}
            loading="lazy"
            class="h-full w-full object-contain"
          />
        </figure>
      ))}
    </div>

    <div class="mt-2 flex items-center justify-between gap-4">
      <p class="text-sm text-zinc-400" aria-live="polite">
        <span data-gallery-current>1</span> / {galleryImages.length}
      </p>
      <div class="flex gap-2">
        <button type="button" data-gallery-prev class="rounded-full bg-white px-4 py-2 text-sm font-medium text-zinc-950 transition hover:bg-zinc-200 focus:outline-none focus:ring-2 focus:ring-white">
          ← Previous
        </button>
        <button type="button" data-gallery-next class="rounded-full bg-white px-4 py-2 text-sm font-medium text-zinc-950 transition hover:bg-zinc-200 focus:outline-none focus:ring-2 focus:ring-white">
          Next →
        </button>
      </div>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-photo-gallery]");
  const trigger = document.querySelector<HTMLButtonElement>("[data-gallery-trigger]");
  const track = dialog?.querySelector<HTMLElement>("[data-gallery-track]");
  const current = dialog?.querySelector<HTMLElement>("[data-gallery-current]");
  const detailsDialog = document.querySelector<HTMLDialogElement>("[data-project-details-dialog]");
  const detailsTitle = detailsDialog?.querySelector<HTMLElement>("[data-project-details-title]");
  const detailsType = detailsDialog?.querySelector<HTMLElement>("[data-project-details-type]");
  const detailsList = detailsDialog?.querySelector<HTMLUListElement>("[data-project-details-list]");
  const detailsDataElement = document.querySelector<HTMLScriptElement>("[data-project-details-data]");
  const projectDetails: Record<string, { type: string; details: string[] }> =
    detailsDataElement?.textContent ? JSON.parse(detailsDataElement.textContent) : {};
  let closeTimer: number | undefined;
  let detailsCloseTimer: number | undefined;

  const updateCounter = () => {
    if (!track || !current) return;
    const index = Math.round(track.scrollLeft / track.clientWidth);
    current.textContent = String(index + 1);
  };

  const move = (direction: number) => {
    track?.scrollBy({ left: direction * track.clientWidth, behavior: "smooth" });
  };

  const closeGallery = () => {
    if (!dialog?.open || dialog.hasAttribute("data-closing")) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      dialog.close();
      return;
    }

    dialog.setAttribute("data-closing", "");
    closeTimer = window.setTimeout(() => dialog.close(), 220);
  };

  trigger?.addEventListener("click", () => {
    dialog?.removeAttribute("data-closing");
    dialog?.showModal();
    track?.scrollTo({ left: 0 });
    updateCounter();
  });

  dialog?.querySelector("[data-gallery-close]")?.addEventListener("click", closeGallery);
  dialog?.querySelector("[data-gallery-prev]")?.addEventListener("click", () => move(-1));
  dialog?.querySelector("[data-gallery-next]")?.addEventListener("click", () => move(1));
  track?.addEventListener("scrollend", updateCounter);
  track?.addEventListener("scroll", () => requestAnimationFrame(updateCounter), { passive: true });

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) closeGallery();
  });

  dialog?.addEventListener("cancel", (event) => {
    event.preventDefault();
    closeGallery();
  });

  dialog?.addEventListener("close", () => {
    window.clearTimeout(closeTimer);
    dialog.removeAttribute("data-closing");
  });

  const closeProjectDetails = () => {
    if (!detailsDialog?.open || detailsDialog.hasAttribute("data-closing")) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      detailsDialog.close();
      return;
    }

    detailsDialog.setAttribute("data-closing", "");
    detailsCloseTimer = window.setTimeout(() => detailsDialog.close(), 220);
  };

  document.querySelectorAll<HTMLButtonElement>("[data-project-details-trigger]").forEach((button) => {
    button.addEventListener("click", () => {
      const title = button.dataset.projectTitle;
      const project = title ? projectDetails[title] : undefined;
      if (!title || !project || !detailsDialog || !detailsTitle || !detailsType || !detailsList) return;

      detailsTitle.textContent = title;
      detailsType.textContent = project.type;
      detailsList.replaceChildren(
        ...project.details.map((detail) => {
          const item = document.createElement("li");
          item.textContent = detail;
          return item;
        })
      );

      detailsDialog.removeAttribute("data-closing");
      detailsDialog.showModal();
    });
  });

  detailsDialog?.querySelector("[data-project-details-close]")?.addEventListener("click", closeProjectDetails);

  detailsDialog?.addEventListener("click", (event) => {
    if (event.target === detailsDialog) closeProjectDetails();
  });

  detailsDialog?.addEventListener("cancel", (event) => {
    event.preventDefault();
    closeProjectDetails();
  });

  detailsDialog?.addEventListener("close", () => {
    window.clearTimeout(detailsCloseTimer);
    detailsDialog.removeAttribute("data-closing");
  });
</script>

<style>
  [data-project-details-dialog][open] {
    animation: gallery-enter 220ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  [data-project-details-dialog][open]::backdrop {
    animation: details-backdrop-enter 220ms ease-out both;
  }

  [data-project-details-dialog][data-closing] {
    animation: gallery-exit 180ms ease-in both;
  }

  [data-project-details-dialog][data-closing]::backdrop {
    animation: details-backdrop-exit 180ms ease-in both;
  }

  [data-photo-gallery][open] {
    animation: gallery-enter 220ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  [data-photo-gallery][open]::backdrop {
    animation: gallery-backdrop-enter 220ms ease-out both;
  }

  [data-photo-gallery][data-closing] {
    animation: gallery-exit 180ms ease-in both;
  }

  [data-photo-gallery][data-closing]::backdrop {
    animation: gallery-backdrop-exit 180ms ease-in both;
  }

  @keyframes gallery-enter {
    from {
      opacity: 0;
      transform: translateY(1rem) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes gallery-exit {
    from {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    to {
      opacity: 0;
      transform: translateY(0.5rem) scale(0.98);
    }
  }

  @keyframes gallery-backdrop-enter {
    from { background-color: rgb(0 0 0 / 0%); }
    to { background-color: rgb(0 0 0 / 80%); }
  }

  @keyframes details-backdrop-enter {
    from { background-color: rgb(0 0 0 / 0%); }
    to { background-color: rgb(0 0 0 / 70%); }
  }

  @keyframes gallery-backdrop-exit {
    from { background-color: rgb(0 0 0 / 80%); }
    to { background-color: rgb(0 0 0 / 0%); }
  }

  @keyframes details-backdrop-exit {
    from { background-color: rgb(0 0 0 / 70%); }
    to { background-color: rgb(0 0 0 / 0%); }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-photo-gallery][open],
    [data-photo-gallery][open]::backdrop,
    [data-photo-gallery][data-closing],
    [data-photo-gallery][data-closing]::backdrop,
    [data-project-details-dialog][open],
    [data-project-details-dialog][open]::backdrop,
    [data-project-details-dialog][data-closing],
    [data-project-details-dialog][data-closing]::backdrop {
      animation: none;
    }
  }
</style>
