---
import Section from "./Section.astro";
import { experience } from "../data/experience";
---

<Section id="experience" title="Work Experience">
  <div class="space-y-7">
    {experience.map((role) => (
      <article class="rounded-xl bg-white p-5">
        <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1">
          <h3 class="text-base md:text-lg font-semibold tracking-tight">
            {role.title}
            <span class="text-zinc-400 font-normal"> — </span>
            {role.company}
            {role.location && (
              <span class="ml-2 text-xs md:text-sm text-zinc-500 font-normal">
                ({role.location})
              </span>
            )}
          </h3>
          <p class="text-xs md:text-sm text-zinc-500">{role.start} – {role.end}</p>
        </div>

        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-zinc-700 print:space-y-0">
          {role.responsibilities.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    ))}
  </div>
</Section>
