---
import { profile } from "../data/profile";
import { cta } from "../data/cta";
import Icon from "./Icon.astro";
---

<header class="pt-10 pb-6 print-tight">
  <div class="container-narrow">
    <div class="flex flex-col md:flex-row md:items-center gap-6 print-gap-tight">
      <div class="flex items-center gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight md:text-4xl">
            {profile.name}
          </h1>
          <p class="text-sm md:text-base text-zinc-600 mt-1">
            {profile.headline}
          </p>
        </div>
      </div>

      <div class="md:ml-auto no-print">
        <button
          type="button"
          class="inline-flex items-center justify-center gap-2 rounded-md bg-zinc-900 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-zinc-800"
          onclick="window.print()"
        >
          <Icon name="printer" class="h-4 w-4" />
          Print / Save PDF
        </button>
      </div>
    </div>

    <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 rounded-xl border border-zinc-200 bg-white px-4 py-3 text-sm font-medium text-zinc-700 shadow-sm print:border-0 print:px-0 print:py-1 print:shadow-none">
      <a class="inline-flex items-center gap-2 decoration-zinc-400 underline-offset-4 transition-colors hover:text-zinc-950 hover:underline focus-visible:underline" href={`mailto:${cta.email}`}>
        <Icon name="mail" class="h-4 w-4 text-zinc-900" />
        {cta.email}
      </a>
      <a class="inline-flex items-center gap-2 decoration-zinc-400 underline-offset-4 transition-colors hover:text-zinc-950 hover:underline focus-visible:underline" href={`tel:${cta.phone.replace(/[^\d+]/g, "")}`}>
        <Icon name="phone" class="h-4 w-4 text-zinc-900" />
        {cta.phone}
      </a>
      {cta.links.map((link) => (
        <a class="inline-flex items-center gap-2 decoration-zinc-400 underline-offset-4 transition-colors hover:text-zinc-950 hover:underline focus-visible:underline print:hidden" href={link.href} target="_blank" rel="noreferrer">
          <Icon name={link.icon} class="h-4 w-4 text-zinc-900" />
          {link.label}
        </a>
      ))}
    </div>

    <div class="mt-6 space-y-6 print-gap-tight">
      <!-- Summary (full width) -->
      <p class="text-sm md:text-base leading-relaxed text-zinc-800">
        {profile.summary}
      </p>

      <!-- Skills -->
      <div class="mt-6 print-flat">
        <h2 class="flex items-center gap-3 text-3xl font-semibold tracking-tight">
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-zinc-900 text-white print:hidden">
            <Icon name="sparkles" class="h-5 w-5" />
          </span>
          Core Skills
        </h2>

        <ul class="mt-3 flex flex-wrap gap-2">
          {profile.highlights.map((h) => (
            <li
              class="core-skill inline-flex items-center rounded-lg bg-zinc-900 px-3 py-1
                     text-xs md:text-sm font-medium text-white"
            >
              {h}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</header>
