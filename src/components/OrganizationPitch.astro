---
import { getCollection } from "astro:content";

const entries = await getCollection("organizations");
const organizations = await Promise.all(
  entries.map(async (entry) => ({
    key: entry.slug,
    organization: entry.data.organization,
    question: entry.data.question ?? `How could I help ${entry.data.organization}?`,
    Content: (await entry.render()).Content,
  })),
);
---

<div class="no-print" data-organization-pitch-root>
  <div data-organization-pitch></div>

  {organizations.map(({ key, organization, question, Content }) => (
    <template data-organization-template={key}>
      <section
        class="container-narrow py-8 md:py-10"
        aria-label={`How I could help ${organization}`}
      >
        <div class="rounded-2xl bg-zinc-900 p-6 text-white shadow-soft md:p-8">
          <div class="mb-6">
            <h2 class="text-3xl font-semibold tracking-tight">{question}</h2>
          </div>
          <div class="text-zinc-200 [&_li]:mb-2 [&_li]:pl-1 [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-5 [&_ul]:marker:text-zinc-400">
            <Content />
          </div>
        </div>
      </section>
    </template>
  ))}
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-organization-pitch-root]");
  const output = root?.querySelector<HTMLElement>("[data-organization-pitch]");
  const key = new URLSearchParams(window.location.search).get("for")?.trim().toLowerCase();

  if (root && output && key) {
    const templates = root.querySelectorAll<HTMLTemplateElement>("[data-organization-template]");
    const template = Array.from(templates).find(
      (candidate) => candidate.dataset.organizationTemplate?.toLowerCase() === key,
    );

    if (template) {
      output.append(template.content.cloneNode(true));
    }
  }
</script>
